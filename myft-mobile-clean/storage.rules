rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos and any other user-owned files
    match /users/{uid}/{allPaths=**} {
      // Public read (optional; set to request.auth != null if you want private)
      allow read: if true;
      // Only the signed-in owner can write to their folder
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is read-only from clients
    match /{allPaths=**} {
      allow read: if true;   // tighten in production if needed
      allow write: if false;
    }
  }
}
