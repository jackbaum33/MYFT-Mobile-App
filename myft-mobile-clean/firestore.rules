rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public reads everywhere (tighten later)
    match /{document=**} {
      allow read: if true;
    }

    // Users collection:
    // - allow CREATE when the payload's uid == auth.uid (works with auto-ID or uid-as-id)
    // - allow UPDATE/DELETE only if the existing doc's uid == auth.uid
    match /users/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
      allow read: if true;
    }

    // Teams - read-only from client, except score-keeping fields
    match /teams/{id} {
      allow read: if true;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).changedKeys()
                         .hasOnly(['record','pointDifferential'])
                    && request.resource.data.pointDifferential is int
                    && request.resource.data.record is list
                    && request.resource.data.record.size() == 2
                    && request.resource.data.record[0] is int
                    && request.resource.data.record[1] is int
                    && request.resource.data.record[0] >= 0
                    && request.resource.data.record[1] >= 0;
      allow create, delete: if false;
    }

    // Players - allow authenticated users to write (for admin panel)
    match /players/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Games - allow authenticated users to write (for admin panel)
    match /games/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Schedule - read-only from client
    match /schedule/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Fantasy Leagues (services/leagues.ts):
    // - any signed-in user can create a league as long as they set
    //   themselves as owner and include themselves in memberUids
    // - any current member can update the league doc (this covers both
    //   starting the draft and advancing picks) — true owner-only
    //   enforcement is an app-level convention only, not checked here yet
    // - only the owner can delete the league (deleteLeague())
    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids is list
                    && request.auth.uid in request.resource.data.memberUids;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberUids;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      // Per-member roster within a league (leagues/{leagueId}/rosters/{uid}).
      // Any current league member can write any roster doc in the league,
      // because startDraft() (run by the owner) creates every member's
      // empty roster doc in one batch — not just their own.
      match /rosters/{uid} {
        allow read: if true;
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
      }

      // Draft pick log (leagues/{leagueId}/picks/{pickId}) - append-only
      // and only ever in your own name; only the league owner can delete
      // picks, which happens as part of deleteLeague() wiping the league.
      match /picks/{pickId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
        allow update: if false;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
